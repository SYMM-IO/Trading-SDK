{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CI",
    "E2E_SEED_PHRASE",
    "GASLESSQ_PRODUCTION_API_KEY",
    "GASLESSQ_PRODUCTION_ORIGIN",
    "GASLESSQ_PRODUCTION_PROTOCOL_INSTANCE",
    "GASLESSQ_STAGING_API_KEY",
    "GASLESSQ_STAGING_ORIGIN",
    "GASLESSQ_STAGING_PROTOCOL_INSTANCE",
    "NODE_ENV",
    "SYMM_TEST_PRIVATE_KEY",
    "SYMM_RUN_INTEGRATION",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_CHAT_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "public/_pagefind/**", "storybook-static/**"]
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
