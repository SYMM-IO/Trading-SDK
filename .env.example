# Repository-root environment, read only by `pnpm dev:mocker` (scripts/dev-mocker.ts).
# Copy to `.env.local` (git-ignored). Each app has its own .env.example for its own variables.

# --- MOCKER ------------------------------------------------------------------
# MOCKER is a private repository that mocks the SYMMIO system (solver, notification
# service, price service, Muon, the gasless relay and the chain) for local testing.
# Ask the team for access. `pnpm dev:mocker` starts it and runs apps/web against it.

# Path to your MOCKER checkout: absolute, ~/..., or relative to this repository.
# Required by test:e2e:mocker. For dev:mocker, omit it to reuse a running MOCKER.
# MOCKER_DIR=~/code/mocker

# MOCKER's panel port (its services use the ports above it) and the app's port.
# MOCKER_BASE_PORT=4600
# MOCKER_WEB_PORT=3001
