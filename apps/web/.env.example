# apps/web environment template. Copy to .env.local. Every variable is optional.
# NEXT_PUBLIC_* values are included in the browser bundle.

# Start the app through pnpm dev:mocker to use MOCKER on Arbitrum. The launcher
# obtains the public RPC, contract addresses and service URLs from MOCKER.
# For standalone pnpm dev, point it to a MOCKER instance that is already running.
# NEXT_PUBLIC_MOCKER_URL=http://localhost:4600

# Optional live Arbitrum RPC. The launcher uses the RPC advertised by MOCKER.
# NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Select the keyless test wallet for local development. The isolated MOCKER E2E
# test sets both values automatically. An injected wallet needs MOCKER's RPC
# configured in the wallet itself before sending transactions.
# NEXT_PUBLIC_E2E_MODE=1
# NEXT_PUBLIC_E2E_ACCOUNT_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# To connect as your own address without changing your wallet, set the test
# wallet address to yours and add it under Setup > Dev wallets in MOCKER.
# The keyless connector cannot produce your wallet's signatures for relay writes.
