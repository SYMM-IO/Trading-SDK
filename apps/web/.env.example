# GaslessQ relayer — server-only secrets, never NEXT_PUBLIC_.
# Consumed by src/app/api/gasless/[...path]/route.ts, one trio per deployment.
# The proxy answers 503 for a deployment whose trio is incomplete, so you only
# need to fill in the deployment you hold a key for.
#
# Production: depositFee 1.0 USDC, minimumDeposit 2.0 USDC.
# GaslessLayer 0x8347953D80037b8d82827246f37EC7442AD188B4
GASLESSQ_PRODUCTION_ORIGIN=https://gaslessq.symmio.foundation
GASLESSQ_PRODUCTION_PROTOCOL_INSTANCE=arbitrum-42161-vibe
GASLESSQ_PRODUCTION_API_KEY=

# Staging: depositFee 0.001 USDC, minimumDeposit 0.01 USDC.
# GaslessLayer 0x386EF97D913acf02B3C9452da4Cd4aaEc82eFBca
GASLESSQ_STAGING_ORIGIN=https://gaslessq-staging.symmio.foundation
GASLESSQ_STAGING_PROTOCOL_INSTANCE=arbitrum-42161-vibe-stage
GASLESSQ_STAGING_API_KEY=
