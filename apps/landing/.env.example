# Affiliate registration → Telegram notifications
#
# The notify route (src/app/api/affiliate-notify/route.ts) posts a summary of
# each on-chain affiliate registration to your team's Telegram channel. Both
# values are server-only — do NOT prefix with NEXT_PUBLIC_, or the bot token
# would leak into the browser bundle. Copy this file to .env.local and fill in
# real values.

# Bot token from @BotFather (send /newbot). Looks like 123456789:ABCdef...
TELEGRAM_BOT_TOKEN=

# Destination channel. Use @your_channel for a public channel, or the numeric
# -100XXXXXXXXXX id for a private channel. Add the bot to the channel as an admin
# with the "Post messages" permission.
TELEGRAM_CHAT_ID=
