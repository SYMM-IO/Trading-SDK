-  const platformFee = notionalValue * platformRate;
-  const solverFee = notionalValue * solverRate;
-  const settlementLoss = Math.max(0, -calculateVibecapsOpenPositionPnl({
-    side,
-    currentPrice,
-    estimatedOpenPrice: expectedFillPrice,
-    submittedQuantity,
-  }));
