+++ b/lib/symmio/trading-config.test.ts
@@ -0,0 +1,57 @@
+import { beforeEach, expect, test, vi } from 'vitest';
+import { VIBECAPS_DEPLOYMENT } from '@/lib/trading/vibecaps/staticConfig';
+import { getSymmioTradingConfig } from './trading-config';
+
+const signer = vi.hoisted(() => ({ getAddress: vi.fn(), signTypedData: vi.fn() }));
+vi.mock('@/lib/trading/vibecaps/sessionKey', () => ({ getSessionKeyService: () => signer }));
+vi.mock('@/lib/trading/vibecaps/client', async () => {
+  const { VIBECAPS_DEPLOYMENT: deployment } = await import('@/lib/trading/vibecaps/staticConfig');
+  return {
+    vibecapsChain: {
+      id: deployment.chain.id,
+      name: 'Trading',
+      nativeCurrency: { name: 'ETH', symbol: 'ETH', decimals: 18 },
+      rpcUrls: { default: { http: [] } },
+    },
+    vibecapsPublicClient: { request: vi.fn() },
+  };
+});
+const address = '0x1111111111111111111111111111111111111111';
+const chainId = VIBECAPS_DEPLOYMENT.chain.id;
+const typedData = {
+  domain: { name: 'Trading', chainId },
+  types: { Message: [{ name: 'value', type: 'uint256' }] },
+  primaryType: 'Message',
+  message: { value: 1n },
+} as const;
+
+beforeEach(() => {
+  signer.getAddress.mockReturnValue(address);
+  signer.signTypedData.mockResolvedValue('0x1234');
+});
+
+test('forwards SDK typed data through the current session signer', async () => {
+  const wallet = await getSymmioTradingConfig().getWalletClient({ chainId, from: address });
+  await expect(wallet.signTypedData({ ...typedData, account: wallet.account! })).resolves.toBe(
+    '0x1234',
+  );
+  expect(signer.signTypedData).toHaveBeenCalledWith(expect.objectContaining({ ...typedData, types: expect.objectContaining(typedData.types) }));
+});
+
+test('rejects a changed session before signing', async () => {
+  const wallet = await getSymmioTradingConfig().getWalletClient({ chainId, from: address });
+  signer.getAddress.mockReturnValue('0x2222222222222222222222222222222222222222');
+  await expect(wallet.signTypedData({ ...typedData, account: wallet.account! })).rejects.toThrow(
+    'Trading session changed',
+  );
+});
+
+test('rejects missing sessions and a different chain', async () => {
+  signer.getAddress.mockReturnValue(null);
+  await expect(getSymmioTradingConfig().getWalletClient({ chainId })).rejects.toThrow(
+    'Enable 1-click',
+  );
+  await expect(getSymmioTradingConfig().getWalletClient({ chainId: 999 })).rejects.toThrow(
+    'Unsupported trading chain',
+  );
+});
diff --git a/b/lib/symmio/trading-config.ts b/lib/symmio/trading-config.ts
new file mode 100644
index 0000000..1803946
--- /dev/null
+++ b/lib/symmio/trading-config.ts
@@ -0,0 +1,51 @@
+import { vibecapsChain, vibecapsPublicClient } from '@/lib/trading/vibecaps/client';
+import { getSessionKeyService } from '@/lib/trading/vibecaps/sessionKey';
+import { VIBECAPS_DEPLOYMENT } from '@/lib/trading/vibecaps/staticConfig';
+import { createConfig, type Config } from '@symmio/trading-core';
+import { createWalletClient, custom, type Address, type PublicClient } from 'viem';
+import { toAccount } from 'viem/accounts';
+import { symmioConfigFromDeployment } from './chainConfig';
+
+let config: Config | undefined;
+
+/** SDK config bound to the current deployment and the existing session signer. */
+export function getSymmioTradingConfig(): Config {
+  if (config) return config;
+  const chainId = VIBECAPS_DEPLOYMENT.chain.id;
+  config = createConfig({
+    defaultChainId: chainId,
+    symmioConfig: symmioConfigFromDeployment(VIBECAPS_DEPLOYMENT),
+    getClient: ({ chainId: requested } = {}) => {
+      if (requested != null && requested !== chainId) throw new Error('Unsupported trading chain');
+      return vibecapsPublicClient as PublicClient;
+    },
+    getWalletClient: async ({ chainId: requested, from }) => {
+      if (requested != null && requested !== chainId) throw new Error('Unsupported trading chain');
+      const signer = getSessionKeyService();
+      const address = signer.getAddress() as Address | null;
+      if (!address) throw new Error('Enable 1-click trading first');
+      if (from && from.toLowerCase() !== address.toLowerCase())
+        throw new Error('Trading session changed; try again');
+      const account = toAccount({
+        address,
+        signMessage: async () => {
+          throw new Error('This signer only supports trading typed data');
+        },
+        signTransaction: async () => {
+          throw new Error('This signer only supports trading typed data');
+        },
+        signTypedData: async (data) => {
+          if (signer.getAddress()?.toLowerCase() !== address.toLowerCase())
+            throw new Error('Trading session changed; try again');
+          return signer.signTypedData(data as Parameters<typeof signer.signTypedData>[0]);
+        },
+      });
+      return createWalletClient({
+        account,
+        chain: vibecapsChain,
+        transport: custom(vibecapsPublicClient),
+      });
+    },
+  });
+  return config;
+}
