+import { describe, expect, it } from 'vitest';
+import { fundingAmount, fundingPreset } from './funding-input';
+
+describe('fee-inclusive funding inputs', () => {
+  it('preserves the exact Max budget in both input modes', () => {
+    const raw = '100.123456789012345678';
+    for (const mode of ['initial_margin', 'order_size'] as const) {
+      const displayed = fundingPreset(raw, 100, mode, 20);
+      expect(fundingAmount(displayed, 'usd', mode, 20, '1')).toBe(raw);
+    }
+  });
+  it('does not add fees to a partial budget', () => {
+    expect(fundingAmount('50', 'usd', 'initial_margin', 20, '1')).toBe('50');
+    expect(fundingPreset('100', 25, 'initial_margin', 20)).toBe('25');
+  });
+});
