-/**
- * The VA prefund one open will draw, in USD, and the part of it this projection
- * counts as collateral.
- *
- * This is the form-side mirror of the provider's `marginAmount`. The two must
- * agree: the form validating one number while the submit path draws a
- * structurally different one is what let a 100% preset hand the user a
- * guaranteed 3111.
- *
- * Exact equality is not achievable — the provider rounds each locked component
- * up in wei and formats the fee term for units — so `totalUsd` is nudged up to
- * collateral precision. It may sit a fraction of a cent above the draw; it must
- * never sit below it. `allocatedCollateralUsd` is deliberately left raw: it
- * feeds a liquidation figure, where rounding up buys the trader headroom that
- * is not there.
- *
- * This is the one owner of how the prefund decomposes. Callers that need a term
- * of it take the term from here. Re-deriving `platformFee + solverFee` at a
- * call site is exactly what put fees into the liquidation buffer.
- */
-export function calculateVibecapsOpenVaPrefund({
-  side,
-  currentPrice,
-  estimatedOpenPrice,
-  slippage,
-  submittedQuantity,
-  leverage,
-  lockedParams,
-  platformOpenFeeRate,
-  solverOpenFeeRate = 0,
-  staticSolverOpenFeeUsd = 0,
-  pricePrecision,
-}: VibecapsOpenVaPrefundInput): VibecapsOpenVaPrefund | null {
-  if (
-    !isPositiveFinite(currentPrice) ||
-    !isPositiveFinite(submittedQuantity) ||
-    !isPositiveFinite(leverage) ||
-    !lockedParams ||
-    !Number.isFinite(staticSolverOpenFeeUsd) || staticSolverOpenFeeUsd < 0
-  ) {
-    return null;
-  }
-
-  const expectedFillPrice = isPositiveFinite(estimatedOpenPrice ?? 0)
-    ? Number(estimatedOpenPrice)
-    : currentPrice;
-  const basis = resolveVibecapsOpenBasis({
-    side: side === 'long' ? 'buy' : 'sell',
-    markPrice: currentPrice,
-    expectedFillPrice,
-    slippage,
-  });
-  if (!basis) return null;
-
-  // Mirror the provider's round-up. Signing rounds the wire price to nearest;
-  // the PREFUND rounds its basis up, so the two are not interchangeable.
-  const fundingBasis = Number.isFinite(pricePrecision as number)
-    ? Number(ceilToPrecision(basis.fundingBasis, pricePrecision as number))
-    : basis.fundingBasis;
-
-  const cvaRate = finiteOrZero(Number(lockedParams.cva)) / 100;
-  const lfRate = finiteOrZero(Number(lockedParams.lf)) / 100;
-  const partyAmmRate = finiteOrZero(Number(lockedParams.partyAmm)) / 100;
-  const platformRate = Math.max(0, finiteOrZero(platformOpenFeeRate));
-  const solverRate = Math.max(0, finiteOrZero(solverOpenFeeRate));
