@@ -0,0 +1,142 @@
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { act, renderHook } from '@testing-library/react';
+import { beforeEach, afterEach, describe, expect, it, vi } from 'vitest';
+import type { ReactNode } from 'react';
+import { usePendingPositionsStore } from '@/stores/pendingPositionsStore';
+import { useSubmittedIntentsStore } from '@/stores/submittedIntentsStore';
+import { useVibecapsOrderExecution } from './use-vibecaps-order-execution';
+
+const mocks = vi.hoisted(() => ({
+  open: vi.fn(),
+  filled: vi.fn(),
+  pending: vi.fn(),
+  signer: vi.fn(),
+}));
+vi.mock('../api/use-sdk-open', () => ({ useSdkInstantOpen: () => ({ mutateAsync: mocks.open }) }));
+vi.mock('../api/use-send-vibecaps-open-trade-alert', () => ({
+  useSendVibecapsOpenTradeAlert: () => vi.fn(),
+}));
+vi.mock('./vibecaps-open-alert-fallback', () => ({
+  waitForVibecapsOpenTelegramAlert: async () => null,
+}));
+vi.mock('@/lib/trading/vibecaps/sessionKey', () => ({
+  getSessionKeyService: () => ({ getAddress: mocks.signer }),
+}));
+vi.mock('@/lib/trading/vibecaps/openChainTime', () => ({
+  readOpenChainTime: async () => ({ timestamp: 1900000000n }),
+}));
+vi.mock('@/lib/notifications', () => ({
+  notifyOrderFilled: mocks.filled,
+  notifySubmittingOrder: mocks.pending,
+  notifyGenericError: vi.fn(),
+}));
+vi.mock('@/lib/posthog', () => ({ trackOnce: vi.fn() }));
+
+const ACCOUNT = '0x1111111111111111111111111111111111111111';
+const ORDER = {
+  symbolId: 1,
+  coin: 'TOKEN',
+  isBuy: true,
+  size: '1.9',
+  price: '100',
+  fundingAmount: '100.000000000000000001',
+  marginUsd: 99,
+  slippage: 0.05,
+};
+
+function setup() {
+  const queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  const invalidate = vi.spyOn(queryClient, 'invalidateQueries');
+  const needsSetup = vi.fn();
+  const result = renderHook(
+    () =>
+      useVibecapsOrderExecution({
+        tradingAddress: ACCOUNT,
+        inputMode: 'initial_margin',
+        orderValue: 100,
+        leverage: 2,
+        szDecimals: 4,
+        tradingFee: 0,
+        getCurrentPrice: () => '100',
+        onNeedsSetup: needsSetup,
+        submitTpSlForPosition: vi.fn(),
+      }),
+    {
+      wrapper: ({ children }: { children: ReactNode }) => (
+        <QueryClientProvider client={queryClient}>{children}</QueryClientProvider>
+      ),
+    },
+  );
+  return { ...result, invalidate, needsSetup };
+}
+
+describe('SDK open submission and reconciliation', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mocks.signer.mockReturnValue(ACCOUNT);
+    mocks.open.mockResolvedValue({ kind: 'enigma', success: true, tempQuoteId: '-7' });
+    usePendingPositionsStore.getState().clear();
+  });
+  afterEach(() => usePendingPositionsStore.getState().clear());
+
+  it('sends the exact total funding budget and leaves acceptance pending', async () => {
+    const { result, invalidate } = setup();
+    await act(() => result.current(ORDER));
+    expect(mocks.open).toHaveBeenCalledWith(
+      expect.objectContaining({
+        fund: { mode: 'full-balance', balance: ORDER.fundingAmount },
+        market: { id: 1 },
+        leverage: 2,
+        slippage: 5,
+        positionType: 0,
+        subAccountAddress: ACCOUNT,
+        deadline: 1900000300n,
+        operationDeadline: 1900000060n,
+      }),
+    );
+    expect(mocks.open.mock.calls[0][0]).not.toHaveProperty('order');
+    expect(usePendingPositionsStore.getState().positions.get(-7)?.status).toBe('pending');
+    expect(mocks.filled).not.toHaveBeenCalled();
+    expect(invalidate).toHaveBeenCalledWith({ queryKey: ['vibecaps', 'balanceInfoBatch'] });
+  });
+
+  it('cleans up and refreshes the displayed balance when submission rejects', async () => {
+    mocks.open.mockRejectedValue({ code: 'INSUFFICIENT_BALANCE' });
+    const { result, invalidate } = setup();
+    let response: Awaited<ReturnType<typeof result.current>> | undefined;
+    await act(async () => {
+      response = await result.current(ORDER);
+    });
+    expect(response?.success).toBe(false);
+    expect(usePendingPositionsStore.getState().positions.size).toBe(0);
+    expect(invalidate).toHaveBeenCalledWith({ queryKey: ['vibecaps', 'balanceInfoBatch'] });
+  });
+
+  it('reconciles a fill delivered before the HTTP response without adding a duplicate row', async () => {
+    mocks.open.mockImplementation(async () => {
+      usePendingPositionsStore.getState().markResolved(-7, 77);
+      usePendingPositionsStore.getState().claimFilledToast(77);
+      return { kind: 'enigma', success: true, tempQuoteId: '-7' };
+    });
+    const { result } = setup();
+    await act(() => result.current(ORDER));
+    expect(usePendingPositionsStore.getState().positions.size).toBe(0);
+    expect(mocks.filled).not.toHaveBeenCalled();
+    expect(useSubmittedIntentsStore.getState().intents.has(77)).toBe(true);
+  });
+
+  it('does not resurrect an order whose failure arrived before the HTTP response', async () => {
+    mocks.open.mockImplementation(async () => {
+      usePendingPositionsStore.getState().failPendingPosition(-7, 'Rejected');
+      return { kind: 'enigma', success: true, tempQuoteId: '-7' };
+    });
+    const { result } = setup();
+    let response: Awaited<ReturnType<typeof result.current>> | undefined;
+    await act(async () => {
+      response = await result.current(ORDER);
+    });
+    expect(response?.success).toBe(false);
+    expect(usePendingPositionsStore.getState().positions.size).toBe(0);
+    expect(mocks.pending).not.toHaveBeenCalled();
+  });
+});
