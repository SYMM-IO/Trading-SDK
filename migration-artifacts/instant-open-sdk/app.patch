-  const integer = digits.slice(0, count).padEnd(count, '0') || '0';
-  // Match parseUnits' positive half-up rounding at the 18-decimal boundary.
-  const rounded = BigInt(integer) + (count < digits.length && digits[count] >= '5' ? 1n : 0n);
-  return rounded < 2n ** 256n ? rounded : 0n;
-}
