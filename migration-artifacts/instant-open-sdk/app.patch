@@ -0,0 +1,38 @@
+import { formatUnits, parseUnits } from 'viem';
+
+function units(value: string): bigint {
+  if (!/^\d+(\.\d*)?$/.test(value)) return 0n;
+  const [whole, fraction = ''] = value.split('.');
+  return parseUnits(`${whole}.${fraction.slice(0, 18)}`, 18);
+}
+
+/** Converts display units to a fee-inclusive USD funding amount without rounding up. */
+export function fundingAmount(
+  size: string,
+  sizeUnit: 'usd' | 'coin',
+  inputMode: 'initial_margin' | 'order_size',
+  leverage: number,
+  price: string,
+): string {
+  let value = units(size);
+  if (sizeUnit === 'coin') value = (value * units(Number(price).toFixed(18))) / 10n ** 18n;
+  if (inputMode === 'order_size')
+    value =
+      Number.isFinite(leverage) && leverage > 0
+        ? (value * 10n ** 18n) / units(String(leverage))
+        : 0n;
+  return formatUnits(value, 18);
+}
+
+/** Presets use the unadjusted balance; only display-unit conversion happens here. */
+export function fundingPreset(
+  balance: string | undefined,
+  percent: number,
+  inputMode: 'initial_margin' | 'order_size',
+  leverage: number,
+): string {
+  if (!balance) return '';
+  let value = (units(balance) * BigInt(percent)) / 100n;
+  if (inputMode === 'order_size') value = (value * units(String(leverage))) / 10n ** 18n;
+  return value > 0n ? formatUnits(value, 18) : '';
+}
