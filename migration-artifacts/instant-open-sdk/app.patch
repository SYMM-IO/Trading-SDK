-function parseMuonMarkPrice(markPrice: string): bigint {
-  const match = /^(\d+\.?\d*|\.\d+)(?:[eE]([+-]?\d+))?$/.exec(markPrice);
-  if (!match) return 0n;
-  const [whole, fraction = ''] = match[1].split('.');
-  const digits = `${whole}${fraction}`.replace(/^0+/, '');
-  if (!digits) return 0n;
-
-  const integerDigits = BigInt(digits.length) + 18n
