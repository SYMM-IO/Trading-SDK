@@ -0,0 +1,48 @@
+'use client';
+
+import { getSymmioTradingConfig } from '@/lib/symmio/trading-config';
+import { VIBECAPS_DEPLOYMENT } from '@/lib/trading/vibecaps/staticConfig';
+import { PositionType } from '@symmio/trading-core';
+import {
+  useInstantOpenAuto,
+  useInstantOpenFees,
+  usePrepareInstantOpenParams,
+} from '@symmio/trading-react';
+import { type Address, zeroAddress } from 'viem';
+
+interface Params {
+  account?: string;
+  symbolId?: number;
+  amount: string;
+  leverage: number;
+  slippage: number;
+  side: 'buy' | 'sell';
+  markPrice?: string;
+}
+
+export function useSdkOpenPreview(params: Params) {
+  const inputs = {
+    config: getSymmioTradingConfig(),
+    chainId: VIBECAPS_DEPLOYMENT.chain.id,
+    solverId: 'enigma' as const,
+    subAccountAddress: (params.account ?? zeroAddress) as Address,
+    market: { id: params.symbolId ?? 0 },
+    positionType: params.side === 'buy' ? PositionType.LONG : PositionType.SHORT,
+    fund: { mode: 'full-balance' as const, balance: params.amount },
+    leverage: params.leverage,
+    // App controls store a fraction; the SDK accepts percent.
+    slippage: params.slippage * 100,
+    markPrice: params.markPrice,
+    query: {
+      enabled: !!params.account && !!params.symbolId && Number(params.amount) > 0,
+      retry: false,
+    },
+  };
+  const prepared = usePrepareInstantOpenParams(inputs);
+  const fees = useInstantOpenFees(inputs);
+  return { prepared, fees };
+}
+
+export function useSdkInstantOpen() {
+  return useInstantOpenAuto({ config: getSymmioTradingConfig() });
+}
