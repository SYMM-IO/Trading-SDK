{
  "name": "@symm-frontier/utils",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic utility helpers for SYMMIO SDK consumers: amount formatting, address helpers, Decimal.js bridge.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./amounts": {
      "types": "./dist/amounts/index.d.ts",
      "import": "./dist/amounts/index.js"
    },
    "./address": {
      "types": "./dist/address/index.d.ts",
      "import": "./dist/address/index.js"
    },
    "./decimal": {
      "types": "./dist/decimal/index.d.ts",
      "import": "./dist/decimal/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "ramda": "^0.32.0"
  },
  "peerDependencies": {
    "viem": "^2.49.0"
  },
  "devDependencies": {
    "@symm-frontier/eslint-config": "workspace:*",
    "@symm-frontier/typescript-config": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/ramda": "^0.31.1",
    "eslint": "^9.39.4",
    "typescript": "^6.0.3",
    "viem": "^2.49.0",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.6"
  }
}
