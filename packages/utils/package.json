{
  "name": "@symmio/utils",
  "version": "0.2.0",
  "description": "Framework-agnostic utility helpers for SYMMIO SDK consumers: amount formatting, address helpers, Decimal.js bridge.",
  "license": "MIT",
  "homepage": "https://github.com/SYMM-IO/Trading-SDK/tree/main/packages/utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SYMM-IO/Trading-SDK.git",
    "directory": "packages/utils"
  },
  "bugs": "https://github.com/SYMM-IO/Trading-SDK/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./amounts": {
      "types": "./dist/amounts/index.d.ts",
      "import": "./dist/amounts/index.js"
    },
    "./address": {
      "types": "./dist/address/index.d.ts",
      "import": "./dist/address/index.js"
    },
    "./decimal": {
      "types": "./dist/decimal/index.d.ts",
      "import": "./dist/decimal/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./number": {
      "types": "./dist/number/index.d.ts",
      "import": "./dist/number/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/fix-dts-extensions.mjs dist",
    "dev": "vite build --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "ramda": "^0.32.0"
  },
  "peerDependencies": {
    "viem": "^2.49.0"
  },
  "devDependencies": {
    "@symmio/eslint-config": "workspace:^",
    "@symmio/typescript-config": "workspace:^",
    "@types/node": "^25.6.0",
    "@types/ramda": "^0.31.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "typescript": "^6.0.3",
    "viem": "^2.49.0",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
