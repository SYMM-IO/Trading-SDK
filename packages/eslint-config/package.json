{
  "name": "@symmio/eslint-config",
  "version": "0.1.2",
  "description": "Shared ESLint flat configs for the SYMMIO SDK monorepo.",
  "license": "MIT",
  "homepage": "https://github.com/SYMM-IO/Trading-SDK/tree/main/packages/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SYMM-IO/Trading-SDK.git",
    "directory": "packages/eslint-config"
  },
  "bugs": "https://github.com/SYMM-IO/Trading-SDK/issues",
  "type": "module",
  "exports": {
    "./base": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js"
    },
    "./react-library": {
      "types": "./dist/react-library.d.ts",
      "import": "./dist/react-library.js"
    },
    "./next-js": {
      "types": "./dist/next-js.d.ts",
      "import": "./dist/next-js.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "lint": "echo \"no lint for config package\"",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "^9.22.0",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^3.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-turbo": "^2.9.8",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.59.1"
  },
  "devDependencies": {
    "@symmio/typescript-config": "workspace:^",
    "eslint": "^9.39.4",
    "typescript": "^6.0.3"
  }
}
