{
  "name": "@symmio/trading-react",
  "version": "1.1.0",
  "description": "React adapter for the SYMMIO SDK. Hooks, providers, and React-bound ergonomics on top of @symmio/trading-core.",
  "license": "MIT",
  "homepage": "https://github.com/SYMM-IO/Trading-SDK/tree/main/packages/trading-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SYMM-IO/Trading-SDK.git",
    "directory": "packages/trading-react"
  },
  "bugs": "https://github.com/SYMM-IO/Trading-SDK/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "import": "./dist/provider/index.js"
    },
    "./account-layer": {
      "types": "./dist/account-layer/index.d.ts",
      "import": "./dist/account-layer/index.js"
    },
    "./instant-layer": {
      "types": "./dist/instant-layer/index.d.ts",
      "import": "./dist/instant-layer/index.js"
    },
    "./wallet": {
      "types": "./dist/wallet/index.d.ts",
      "import": "./dist/wallet/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./transactions": {
      "types": "./dist/transactions/index.d.ts",
      "import": "./dist/transactions/index.js"
    },
    "./markets": {
      "types": "./dist/markets/index.d.ts",
      "import": "./dist/markets/index.js"
    },
    "./fees": {
      "types": "./dist/fees/index.d.ts",
      "import": "./dist/fees/index.js"
    },
    "./price-service": {
      "types": "./dist/price-service/index.d.ts",
      "import": "./dist/price-service/index.js"
    },
    "./candles": {
      "types": "./dist/candles/index.d.ts",
      "import": "./dist/candles/index.js"
    },
    "./orderbook": {
      "types": "./dist/orderbook/index.d.ts",
      "import": "./dist/orderbook/index.js"
    },
    "./pools": {
      "types": "./dist/pools/index.d.ts",
      "import": "./dist/pools/index.js"
    },
    "./inventory": {
      "types": "./dist/inventory/index.d.ts",
      "import": "./dist/inventory/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/fix-dts-extensions.mjs dist",
    "dev": "vite build --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@symmio/trading-core": "workspace:^",
    "@tanstack/react-query": "^5.100.0",
    "decimal.js": "^10.4.3",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.49.0",
    "wagmi": "^3.4.2"
  },
  "devDependencies": {
    "@symmio/eslint-config": "workspace:^",
    "@symmio/typescript-config": "workspace:^",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "happy-dom": "^16.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.3",
    "viem": "^2.49.0",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.10",
    "wagmi": "^3.4.2"
  }
}
